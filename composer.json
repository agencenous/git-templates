{
    "name": "agencenous/git-templates",
    "version": "0.0.2",
    "description": "Install GitLab issue templates from a local directory or a remote repository.",
    "type": "composer-plugin",
    "license": "GPL-3.0-or-later",
    "minimum-stability": "dev",
    "keywords": ["git", "gitlab", "templates", "issues"],
    "autoload": {
        "psr-4": {
            "AgenceNous\\GitTemplates\\": "src/"
        }
    },
    "require": {
        "php": ">=8.1",
        "composer-plugin-api": "^2.0",
        "symfony/console": "^6.0 || ^7.0",
        "symfony/process": "^6.0 || ^7.0"
    },
    "require-dev": {
        "composer/composer": "^2.0"
    },
    "extra": {
        "class": "AgenceNous\\GitTemplates\\ComposerPlugin"
    },
    "bin": [
        "bin/git-templates"
    ],
    "config": {
        "sort-packages": true
    }
}
